{
  "name": "cmuxagent",
  "version": "3.7.2",
  "description": "Interactive subagents for Pi running in visible cmux surfaces",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Sean",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motionid/cmuxagent.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts test/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "typebox": "^1.3.6",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
